/* Centralized semantic tokens — referenced by function, not appearance.
   16-color-safe: widgets pair color with text + weight, so meaning survives
   non-truecolor terminals and color-blindness. Accent is reserved for focus. */
$verdict-block: #f85149;
$verdict-warn: #e3b341;
$verdict-pass: #3fb950;
$verdict-escalate: #58a6ff;
$sev-high: #f0883e;
$scope-out: #f85149;
$status-ok: #3fb950;
$status-warn: #e3b341;
$status-err: #f85149;
$accent: #58a6ff;
$text-muted: #8b949e;

Screen {
    layout: vertical;
}

#topbar {
    dock: top;
    height: 1;
    background: $panel;
    color: $text;
}

#main {
    height: 1fr;
}

#main > Container {
    border: round $panel-lighten-2;
    width: 1fr;
}

/* Chat is the primary surface now (unified assistant stream) — give it the room;
   the flanking Sessions + Working-Memory panes are narrower (operator UX, 2026-07-21). */
#sessions { width: 2fr; }
#events { width: 6fr; }
#memory { width: 2fr; }

/* #28 Chat pane (replaces the Verdicts/Events pane). The #events Container keeps
   its 3fr width + round border; style the inner scrollback + docked input. The log
   never scrolls horizontally — long lines wrap to the pane (wrap=True + min_width=0). */
#chat-log { overflow-x: hidden; overflow-y: auto; height: 1fr; }
#chat-input { dock: bottom; height: 3; border: round $panel-lighten-2; }

/* Below the 80x24 minimum: a centered hint replaces the dashboard (toggled in code). */
#resize-hint {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $status-warn;
    text-style: bold;
}

/* Focus affordance: the focused pane gets the accent border (accent = interaction only). */
#main > Container:focus-within {
    border: round $accent;
}

/* Inspector modal (Phase 4): a centered dialog over a dimmed screen. */
InspectorScreen {
    align: center middle;
}
#inspector {
    width: 90%;
    height: 90%;
    background: $panel;
    border: round $accent;
}
#inspector-title {
    dock: top;
    height: 1;
    color: $text;
    text-style: bold;
}
#inspector-hint {
    dock: bottom;
    height: 1;
    color: $text-muted;
}
#inspector-nav {
    width: 28;
    border-right: solid $panel-lighten-2;
}
#inspector-body {
    width: 1fr;
}
#inspector-filter {
    height: 3;
}

/* Help modal (Phase 5): a small centered keymap overlay. */
HelpScreen {
    align: center middle;
}
#help {
    width: 60;
    height: auto;
    max-height: 90%;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}
#help-title {
    text-style: bold;
    color: $text;
}
#help-hint {
    color: $text-muted;
}
