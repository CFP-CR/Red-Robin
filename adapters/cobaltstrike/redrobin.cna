# adapters/cobaltstrike/redrobin.cna
# Red Robin CS Adapter — Aggressor master script.
#
# Loaded in CS Client; OBSERVES operator activity and ships it to the Red Robin
# daemon on localhost:7777 via HTTP. This script is a capture hook only.
#
# It does NOT intercept, gate, block, or modify any command. The synchronous
# OPSEC pre-flight gate — the alias overrides, the /v1/verdict/quick round-trip
# and the Layer B verdict console messages — was removed wholesale; the
# operator's console behaves exactly as stock Cobalt Strike.
#
# The three capture surfaces, all passthrough-safe:
#   - on beacon_input    -> beacon.command_input
#   - set BEACON_OUTPUT  -> beacon.command_output (always returns $2 unchanged)
#   - on beacon_initial  -> beacon.initial (+ a load-time backfill)

import java.net.*;
import java.io.*;

global('$REDROBIN_URL $REDROBIN_TOKEN $REDROBIN_SESSION_ID $REDROBIN_HTTP $REDROBIN_EVENT_STREAM');
$REDROBIN_URL = "http://localhost:7777";
$REDROBIN_TOKEN = "";
$REDROBIN_SESSION_ID = "";
$REDROBIN_HTTP = $null;
$REDROBIN_EVENT_STREAM = $null;


# ===== Java version guard =====
# HttpClient (java.net.http.*) is Java 11+ only. CS 4.12 ships with
# Java 17+ but operators on older CS distributions or with bring-your-own
# JVM setups may still have Java 8 — abort with a clear message rather
# than fail with cryptic "Unknown class HttpClient" errors downstream.
sub redrobin_check_java_version {
    local('$version $major_str $major');
    $version = [System getProperty: "java.version"];

    # Defensive: restrictive SecurityManager can deny this property.
    if ($version is $null) {
        warn("[Red Robin] cannot read java.version system property; assuming Java 11+");
        return true;
    }

    # Java 11+: "11.0.21" / "17.0.9" / "21.0.2" / "25.0.1"
    # Java 8 : "1.8.0_392"
    $major_str = split('\.', $version)[0];
    $major = parseNumber($major_str);
    if ($major < 11) {
        warn("[Red Robin] FATAL: Java " . $version . " detected. Red Robin requires Java 11+.");
        warn("[Red Robin] Upgrade your CS Client JVM (e.g., install Temurin 21) and reload this script.");
        return false;
    }
    return true;
}

if (!redrobin_check_java_version()) {
    throw "Red Robin: Java 11+ required (see previous warn lines).";
}


# ===== Token loading =====
sub redrobin_load_token {
    local('$path $reader $line');
    $path = systemProperties()["user.home"] . "/.redrobin/transport.token";
    $reader = [new java.io.BufferedReader: [new java.io.FileReader: $path]];
    $line = [$reader readLine];
    [$reader close];
    return $line;
}


# ===== HTTP POST helper (delegates to JAR; ~150ms target on healthy daemon) =====
# All HTTP machinery lives in com.redrobin.aggressor.RedRobinHttp.post().
# Sleep just translates the call and handles errors with sanitized logging.
# Returns response body string on success, "" on any error (fail-open
# semantics preserved per caller contract).
sub redrobin_http_post {
    global('$REDROBIN_HTTP $REDROBIN_URL $REDROBIN_TOKEN');
    local('$path $body $err');
    ($path, $body) = @_;

    try {
        return [$REDROBIN_HTTP post: $path, $body];
    } catch $e {
        $err = redrobin_sanitize_error($e);
        if ($err ismatch '.*(ConnectException|refused).*') {
            warn("[Red Robin] daemon connection refused at " . $REDROBIN_URL . " — is the daemon running?");
        } else if ($err ismatch '.*(HttpTimeout|timed out).*') {
            warn("[Red Robin] daemon timeout at " . $REDROBIN_URL . " (>200ms) — slow network or overloaded daemon");
        } else if ($err ismatch '.*UnknownHost.*') {
            warn("[Red Robin] cannot resolve daemon host in " . $REDROBIN_URL);
        } else if ($err ismatch '.*HttpException.*') {
            warn("[Red Robin] daemon returned non-2xx for " . $path . " — see daemon log");
        } else {
            warn("[Red Robin] HTTP error: " . $err);
        }
        return "";
    }
}


# ===== HTTP GET helper (delegates to JAR) =====
# Returns %(code => N, body => "..."). code=0 means caught Java exception
# (connect/timeout/DNS); code>=400 means daemon answered with non-2xx.
# Caller chooses how to react to each.
sub redrobin_http_get {
    global('$REDROBIN_HTTP $REDROBIN_URL $REDROBIN_TOKEN');
    local('$path $result');
    $path = $1;

    try {
        $result = [$REDROBIN_HTTP get: $path];
        return %(code => [$result code], body => [$result body]);
    } catch $e {
        return %(code => 0, body => "");
    }
}


# ===== JSON helpers (Sleep has no native JSON; use String.replace tricks) =====
sub redrobin_escape_json {
    local('$s');
    $s = $1;
    $s = replace($s, '\\\\', '\\\\\\\\');
    $s = replace($s, '"', '\\\\"');
    $s = replace($s, "\n", '\\\\n');
    $s = replace($s, "\r", '\\\\r');
    $s = replace($s, "\t", '\\\\t');
    return $s;
}


# ===== Error sanitization =====
# Strip bearer token + token value from exception messages before logging.
# The Aggressor Script Console appears in engagement screenshots / shared
# screens; an exception's toString() can include request headers in some
# JVMs. Wrap every exception via this sub before printing.
#
# Three redaction layers (ordered most-specific to most-general):
#   1. The raw token value (covers any place it appears verbatim).
#   2. `Authorization: Bearer <token>` header pattern.
#   3. `?token=<value>` / `&token=<value>` URL query params — added
#      for #111. No caller passes the token in a query string today,
#      but any Java exception whose message embeds a URI
#      (URISyntaxException, IOException with cause) could leak the
#      token here. This redaction is defensive and a no-op against
#      today's logs — keep it.
sub redrobin_sanitize_error {
    local('$err_str');
    $err_str = "" . $1;
    if (strlen($REDROBIN_TOKEN) > 8) {
        $err_str = replace($err_str, $REDROBIN_TOKEN, '***REDACTED***');
    }
    $err_str = replace($err_str, 'Bearer [A-Za-z0-9_\-\.=]+', 'Bearer ***REDACTED***');
    $err_str = replace($err_str, '([?&])token=[^\s&"\\\']+', '$1token=***REDACTED***');
    return $err_str;
}


# ===== Integrity level (Slice 11) =====
# Canonical CS elevated-context detection: &binfo($bid, "user") returns the
# same string CS displays in the beacon table — e.g. "CORP\\admin *" with a
# trailing " *" when the beacon runs in high-integrity context. Community
# prior art: readloud/CobaltStrike-ToolKit Initial-LAdminCheck.cna and
# S1ckB0y1337/Cobalt-Strike-CheatSheet. Audit pass 2 #2.4: &binfo("integrity")
# is NOT a documented Aggressor key, so we MUST derive from the user string.
# If a future CS release drops the " *" separator this check returns $null
# (safe-fail — Sigma rules with IntegrityLevel: High simply don't fire).
# Distinguishing Medium/Low/System requires a beacon-side BOF (deferred to v0.2).
sub redrobin_integrity_level {
    local('$u');
    $u = binfo($1, "user");
    if ($u is $null) { return $null; }
    if (right($u, 2) eq " *") { return "High"; }
    return $null;
}


# ===== Envelope helper (private, called by emit subs below) =====
# Builds the v0.1 wire envelope shell around a pre-built event JSON. The
# event-body construction lives in the per-type emit subs because each
# event type has different required fields (verified 2026-05-24 against
# protocol/schemas/v0.1/events/*.schema.json + curl probes returning
# explicit envelope_errors / event_errors).
sub redrobin_envelope {
    global('$REDROBIN_HTTP $REDROBIN_SESSION_ID');
    local('$event_json $evt_id');
    $event_json = $1;
    # Guard the ulid deref. If $REDROBIN_HTTP is null (init/handshake failed after a
    # daemon restart without a clean .cna reload), `[$REDROBIN_HTTP ulid]` throws an
    # uncaught NPE. Every emit sub calls this BEFORE its try/catch, so that NPE escapes
    # the sub — and in the `set BEACON_OUTPUT` filter it aborts the hook before `return $2`,
    # SUPPRESSING the operator's beacon output (commands task with no result). The capture
    # path must NEVER be able to suppress operator output — fall back to a client-free id.
    $evt_id = iff($REDROBIN_HTTP !is $null, "evt_" . [$REDROBIN_HTTP ulid], "evt_noclient");
    return '{"spec_version":"0.1.0",' .
           '"id":"' . $evt_id . '",' .
           '"ts":"' . [[java.time.Instant now] toString] . '",' .
           '"source":{"adapter":"cs-aggressor","version":"1.0.0","engagement_id":"unknown"' .
           iff(strlen($REDROBIN_SESSION_ID) > 0, ',"adapter_session_id":"' . $REDROBIN_SESSION_ID . '"', "") . '},' .
           '"event":' . $event_json .
           '}';
}

# ===== Event emit subs (one per schema type) =====
# Each emit sub is synchronous (per #134 fix b7c7c69 — no internal fork()
# since the fork's isolated scope lost access to $REDROBIN_HTTP). Each
# wraps its HTTP POST in try/catch so daemon outages or 4xx never bubble
# out to suppress operator beacon output via Sleep filter semantics.
#
# Schema sources verified by curl 2026-05-24:
#   beacon.command_input  requires {type, bid, operator, command, raw}
#   beacon.command_output requires {type, bid, task_id, output}

sub redrobin_emit_command_input {
    local('$bid $operator $command $raw $correlation_id $event_json $body');
    ($bid, $operator, $command, $raw, $correlation_id) = @_;
    $event_json = '{"type":"beacon.command_input",' .
                  '"bid":"' . redrobin_escape_json($bid) . '",' .
                  '"operator":"' . redrobin_escape_json($operator) . '",' .
                  '"command":"' . redrobin_escape_json($command) . '",' .
                  '"raw":"' . redrobin_escape_json($raw) . '"' .
                  iff(strlen($correlation_id) > 0, ',"correlation_id":"' . redrobin_escape_json($correlation_id) . '"', "") .
                  '}';
    $body = redrobin_envelope($event_json);
    try {
        redrobin_http_post("/v1/events", $body);
    } catch $e {
        # Swallow silently — see #134 commit b7c7c69 rationale.
    }
}

sub redrobin_emit_command_output {
    local('$bid $task_id $output $correlation_id $event_json $body');
    ($bid, $task_id, $output, $correlation_id) = @_;
    $event_json = '{"type":"beacon.command_output",' .
                  '"bid":"' . redrobin_escape_json($bid) . '",' .
                  '"task_id":"' . redrobin_escape_json($task_id) . '",' .
                  '"output":"' . redrobin_escape_json($output) . '"' .
                  iff(strlen($correlation_id) > 0, ',"correlation_id":"' . redrobin_escape_json($correlation_id) . '"', "") .
                  '}';
    $body = redrobin_envelope($event_json);
    try {
        redrobin_http_post("/v1/events", $body);
    } catch $e {
        # Swallow silently — see #134 commit b7c7c69 rationale.
    }
}

# beacon.initial — emitted on each new beacon (on beacon_initial) + backfilled
# for pre-existing beacons on load. Schema (protocol/schemas/v0.1/events/
# beacon_initial.schema.json) REQUIRES all 8 fields incl. arch enum
# (x86|x64|arm64) + integer pid/ppid, additionalProperties:false — a wrong
# shape gets a 400 (swallowed) and no session appears. binfo keys + the
# integrity " *" strip are validated by the live operator-smoke (Task 6).
sub redrobin_emit_beacon_initial {
    local('$bid $host $user $arch $pid $ppid $il $event_json $body');
    $bid = $1;
    $host = binfo($bid, "computer");
    $user = binfo($bid, "user");
    # binfo("user") carries a trailing " *" in high-integrity context (see
    # redrobin_integrity_level). Strip it so the wire user is clean.
    if ($user !is $null && right($user, 2) eq " *") {
        $user = substr($user, 0, strlen($user) - 2);
    }
    $arch = binfo($bid, "arch");   # CS reports "x86" / "x64"
    $pid  = binfo($bid, "pid");
    $ppid = binfo($bid, "ppid");
    $il = redrobin_integrity_level($bid);
    # Schema requires non-empty strings + integer pid/ppid; default safely.
    if ($host is $null) { $host = "unknown"; }
    if ($user is $null) { $user = "unknown"; }
    if ($arch is $null) { $arch = "x64"; }
    if ($il is $null) { $il = "Medium"; }
    if ($pid is $null) { $pid = 0; }
    if ($ppid is $null) { $ppid = 0; }
    $event_json = '{"type":"beacon.initial",' .
                  '"bid":"' . redrobin_escape_json($bid) . '",' .
                  '"host":"' . redrobin_escape_json($host) . '",' .
                  '"user":"' . redrobin_escape_json($user) . '",' .
                  '"integrity_level":"' . redrobin_escape_json($il) . '",' .
                  '"arch":"' . redrobin_escape_json($arch) . '",' .
                  '"pid":' . $pid . ',' .
                  '"ppid":' . $ppid . '}';
    $body = redrobin_envelope($event_json);
    try {
        redrobin_http_post("/v1/events", $body);
    } catch $e {
        # Swallow silently — see #134 commit b7c7c69 rationale.
    }
}


# ===== Adapter handshake (3-attempt retry with backoff) =====
# Daemon may be still booting when operator loads the .cna. Single-shot
# handshake left the alias gate in a permanently failed state if the
# first attempt missed the boot window. Retry with 500/1000/2000ms
# backoff covers the typical daemon-boot race without being annoying.
sub redrobin_handshake_with_retry {
    local('$manifest_json $response $attempt $delay');
    $manifest_json = '{"manifest":{"manifest_version":"0.1.0","spec_versions_supported":">=0.1.0,<0.2.0",' .
                     '"name":"cs-aggressor","version":"1.0.0","capabilities":{"tui_dispatch":false,' .
                     '"output_observe":true,"console_annotation":false,"emergency_kill_switch":false,' .
                     '"command_modification":false},"events_emitted":["beacon.command_input","beacon.command_output",' .
                     '"beacon.initial"],' .
                     '"requirements":{"cobalt_strike":">=4.12"}}}';

    $attempt = 1;
    while ($attempt <= 3) {
        $response = redrobin_http_post("/v1/adapters/connect", $manifest_json);
        if ($response ismatch '.*"adapter_session_id":"(ses_[^"]+)".*') {
            $REDROBIN_SESSION_ID = matched()[0];
            println("[Red Robin] handshake OK; session=" . $REDROBIN_SESSION_ID);
            return;
        }
        $delay = 500 * (1 << ($attempt - 1));
        warn("[Red Robin] handshake attempt " . $attempt . "/3 failed; retrying in " . $delay . "ms");
        sleep($delay);
        $attempt = $attempt + 1;
    }
    warn("[Red Robin] handshake failed after 3 attempts. Verify daemon at " . $REDROBIN_URL . " and reload the .cna.");
}


# ===== JAR helper init =====
# Load com.redrobin.aggressor.RedRobinHttp from sibling jars/ dir via
# URLClassLoader (Sleep's 'import from:' is broken on Java 9+ per the
# PyCobalt comment at https://github.com/dcsync/pycobalt/blob/master/aggressor/json.cna).
# The .cna NEVER reflects on jdk.internal or sun.* classes — Sleep only
# touches our public RedRobinHttp class (loaded in the unnamed module,
# same as Sleep itself, so JVM access check passes trivially).
sub redrobin_init_http {
    global('$REDROBIN_HTTP');
    local('$jar_path $jar_url $loader $cls $string_cls $ctor');

    $jar_path = script_resource() . '/jars/redrobin-aggressor-http-1.0.2.jar';
    $jar_url = [[[new java.io.File: $jar_path] toURI] toURL];
    $loader = [new java.net.URLClassLoader: @($jar_url)];

    $cls = [java.lang.Class forName: 'com.redrobin.aggressor.RedRobinHttp', false, $loader];
    $string_cls = [java.lang.Class forName: 'java.lang.String'];
    $ctor = [$cls getConstructor: @($string_cls, $string_cls)];
    $REDROBIN_HTTP = [$ctor newInstance: @($REDROBIN_URL, $REDROBIN_TOKEN)];
}


# ===== Boot =====
$REDROBIN_TOKEN = redrobin_load_token();
redrobin_init_http();
redrobin_handshake_with_retry();

# Backfill beacon.initial for beacons that checked in BEFORE this .cna loaded
# (on beacon_initial only fires for NEW check-ins). beacons() returns a list
# of maps with an "id" key per active beacon. Runs after the handshake set
# $REDROBIN_SESSION_ID, so the events carry the adapter session id.
foreach $_rr_b (beacons()) {
    redrobin_emit_beacon_initial($_rr_b['id']);
}


# ===== Path 3 — Output observation (passthrough-safe filter hook) =====
# Aggressor BEACON_OUTPUT signature ($1=bid, $2=output, $3=ts, $4=jobid):
#   default.cna line 805 comment: "beaconid, whatever: meh too, timestamp, jobid"
#   default.cna line 808 implementation: `$jid = $4`
# We surface $4 as task_id; if CS didn't assign one (e.g., for output
# without a backing job), default to "" — the schema requires the field
# but allows any string value.
set BEACON_OUTPUT {
    local('$task_id $correlation_id');
    # B3 auto-obs ROOT: skip emit for Red Robin's own blogged lines.
    # Display is preserved (return $2 unchanged); only the emission to
    # /v1/events is suppressed, breaking the self-ingestion loop where CS
    # treats our blog() output as beacon output and the hook re-POSTs it.
    #
    # Uses `!is $null` + `ismatch` — both are the file's established Sleep
    # idioms (see the error-classification chain in redrobin_http_post).
    # NOTE: `ismatch` is deliberate — Sleep's `hasmatch` is a STATEFUL iterator
    # that toggles true/false across successive identical strings, which once
    # caused a silent fail-open (#144). Never swap it back. The earlier
    # candidate using
    # `[$str startsWith "X"]` (Sleep's Java-HOA-on-scalar) had ZERO precedent
    # in this `.cna` — and since this hook is smoke-only (no CI), the first
    # regression would surface on the operator's keyboard. Stay in-idiom.
    #
    # Regex anchor `^` makes the prefix intent explicit; `\[` and `\]` are
    # required because `[` is a regex metacharacter.
    if ($2 !is $null && $2 ismatch '^\[Red Robin\].*') {
        return $2;
    }
    $task_id = iff($4 !is $null, $4, "");
    # $5 is the per-command correlation id (verified live 2026-05-27).
    $correlation_id = iff($5 !is $null, $5, "");
    redrobin_emit_command_output($1, $task_id, $2, $correlation_id);
    return $2;
}

# Operator-input observation event (Aggressor `on beacon_input`):
#   $1 = beacon ID
#   $2 = operator nickname (verified vysecurity/AggressorScripts-1)
#   $3 = command line typed by operator (raw)
#   $4 = timestamp (unused)
# Replaces an earlier `on beacon_tasked` handler that gave us only
# ($1=bid, $2=task_summary) — missing the operator + command fields
# required by the v0.1 schema for beacon.command_input. See #138.
on beacon_input {
    local('@parts $command $correlation_id');
    @parts = split(' ', $3);
    $command = iff(size(@parts) > 0, @parts[0], "");
    # $5 = per-command correlation id (see BEACON_OUTPUT note). Forward it so the
    # enricher can pair this command's raw text to its later output exactly.
    $correlation_id = iff($5 !is $null, $5, "");
    redrobin_emit_command_input($1, $2, $command, $3, $correlation_id);
}

# New-beacon observation event (Aggressor `on beacon_initial`): $1 = bid.
on beacon_initial {
    redrobin_emit_beacon_initial($1);
}


println("[Red Robin] .cna loaded; capture active (observe-only, no interception).");


# ===== Heartbeat — surface daemon outages in the CS event log =====
# Without this loop the operator would silently keep working while capture is
# dropping on the floor. Hitting /v1/adapter/heartbeat every 30s gives them a
# visible warning when the daemon goes away mid-engagement.
sub redrobin_heartbeat {
    local('$result $code');
    $result = redrobin_http_get("/v1/adapter/heartbeat?adapter=cs-main");
    $code = $result["code"];
    if ($code == 0) {
        warn("[Red Robin] daemon unreachable; command capture is being dropped");
    } else if ($code != 200) {
        warn("[Red Robin] daemon heartbeat returned " . $code . "; command capture may be dropping");
    }
}

# ===== Heartbeat fork — DISABLED for v0.1 =====
# Originally a 30s fork{} loop calling redrobin_heartbeat(). Empirical
# testing 2026-05-18 proved Sleep's fork() creates a FULLY ISOLATED
# execution context: top-level globals (set via global('$X')) are not
# visible to the fork, AND top-level direct scalar assignments (like
# $REDROBIN_URL = "...") are ALSO not visible. The fork's scope is
# constructed from scratch.
#
# Operational impact of disabling: zero. Every redrobin_http_post call
# (handshake + the per-command capture emits) already catches network
# errors and emits "[Red Robin] daemon connection refused at ..." warn
# lines. The operator sees daemon outages at the moment they type a
# command — not 30s later via a proactive heartbeat. Adequate for v0.1.
#
# Re-enable in v0.1.x via Sleep's lambda(...) to explicitly capture
# variables INTO the fork closure (Task #110). Pattern:
#   fork(lambda({ ... }, \$_http => \$REDROBIN_HTTP));
# where \$_http becomes visible inside the closure body.
#
# fork({
#     while (1) {
#         sleep(30000);
#         redrobin_heartbeat();
#     }
# });


# ===== Script unload cleanup =====
# CURRENTLY A NO-OP, DELIBERATELY KEPT.
#
# This hook existed to close the Java event-stream client that consumed
# opsec.verdict frames. That consumer was removed with the pre-flight gate,
# so nothing assigns $REDROBIN_EVENT_STREAM any more and the `!is $null`
# guard short-circuits on every unload. That is exactly the edge case the
# guard was written for (unload firing before the stream was ever created),
# so the hook is safe as-is.
#
# It is retained rather than deleted because it is the established teardown
# seam: if this adapter ever again owns a background Java resource (a
# long-lived client, a watcher thread), its close() belongs here. Deleting
# the hook would just mean re-deriving it later.
#
# Event-name verification: Aggressor's `on script_unload` event is
# documented in the Cobalt Strike Aggressor Script Manual (Fortra),
# section "Common Events", and used in community scripts (e.g.
# harleyQu1nn/AggressorScripts/utils.cna) for the same cleanup-on-
# reload pattern.
on script_unload {
    if ($REDROBIN_EVENT_STREAM !is $null) {
        [$REDROBIN_EVENT_STREAM close];
    }
}
