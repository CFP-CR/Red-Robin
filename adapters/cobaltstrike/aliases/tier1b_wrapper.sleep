# Tier 1B: wrappers. The DAEMON inspects the raw command line for arg
# patterns like 'nxc ldap', 'Rubeus.exe kerberoast', 'Invoke-Mimikatz' etc.
# Each alias passes the reconstructed raw to the gate and dispatches the
# args on PASS/WARN/ESCALATE. Uses redrobin_alias_parse() helper defined
# in tier1a_gate.sleep (loaded first per redrobin.cna include order).

alias shell {
    local('%p');
    %p = redrobin_alias_parse("shell", @_);
    if (redrobin_alias_require_args($1, "shell", %p['args'])) {
        if (redrobin_gate($1, "shell", %p['raw'])) {
            &bshell($1, %p['args']);
        }
    }
}

