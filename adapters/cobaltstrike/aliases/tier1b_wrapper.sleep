# Tier 1B: wrappers. The DAEMON inspects $0 (full raw line) for arg patterns
# like 'nxc ldap', 'Rubeus.exe kerberoast', 'Invoke-Mimikatz' etc. Each alias
# stub just passes $0 to the gate and forwards if PASS/WARN.

alias shell {
    if (redrobin_gate($1, "shell", $0)) {
        local('$args');
        $args = substr($0, strlen("shell ")+1);
        &bshell($1, $args);
    }
}

alias powershell {
    if (redrobin_gate($1, "powershell", $0)) {
        local('$args');
        $args = substr($0, strlen("powershell ")+1);
        &bpowershell($1, $args);
