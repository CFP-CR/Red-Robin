# Tier 1A: direct Beacon commands. Each alias body uses the CANONICAL SAFE
# PATTERN: substr($0, strlen("<cmd> ")+1) to extract raw arg string.
# This avoids the $2-is-first-token trap (Aggressor docs: $2 = first
# whitespace-tokenized arg, NOT entire arg string).
#
# Sleep function references use the symbol from BeaconTaskBridge bytecode
# (see docs/aggressor-alias-args.md for mapping table — verified Phase 1 spike).

alias mimikatz {
    if (redrobin_gate($1, "mimikatz", $0)) {
        local('$args');
        $args = substr($0, strlen("mimikatz ")+1);
        &bmimikatz($1, $args);
    }
}

alias dcsync {
    if (redrobin_gate($1, "dcsync", $0)) {
        local('$rest @parts');
        $rest = substr($0, strlen("dcsync ")+1);
        @parts = split(' ', $rest);
        if (size(@parts) >= 2) {
            &bdcsync($1, @parts[0], @parts[1]);
        } else {
            &bdcsync($1, @parts[0]);
        }
    }
}

alias hashdump {
    if (redrobin_gate($1, "hashdump", $0)) {
        &bhashdump($1);
    }
}

alias logonpasswords {
    if (redrobin_gate($1, "logonpasswords", $0)) {
