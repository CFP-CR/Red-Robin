# Tier 1A: direct Beacon commands. Each alias body uses redrobin_alias_parse()
# to reconstruct both the args string and the full raw command line.
#
# Sleep function references use the symbol from BeaconTaskBridge bytecode
# (see docs/aggressor-alias-args.md for mapping table — verified Phase 1 spike).

# Parse an alias body's @_ into a hash with two keys:
#   'args' — the args string, joined with spaces. "" if operator typed
#            just the bare alias name.
#   'raw'  — the reconstructed full command line: "<cmd>" or "<cmd> <args>".
#            This is what gets sent to the daemon for rule eval — rules
#            need the args to match patterns like "mimikatz logonpasswords"
#            or "shell nxc ldap".
#
# CS Aggressor passes alias args via @_ as [bid, arg1, arg2, ...]. Quoting
# is handled by CS: `mimikatz "lsadump::sam /system"` arrives as
# [bid, "lsadump::sam /system"] (single arg).
#
# Empirical discovery 2026-05-18: $0 inside a CS Aggressor alias body
# does NOT contain the full typed command line (despite CS docs). It
# appears to be just the alias name. The previous pattern
# substr($0, strlen("<cmd> ")+1) ALWAYS returned the wrong substring
# because Sleep's substr modular-wraps when start > strlen($0). Bare
# `mimikatz` AND `mimikatz logonpasswords` BOTH dispatched
# &bmimikatz($bid, "imikatz") which mimikatz_doLocal rejected with
# 'ERROR ... "imikatz" command of "standard" module not found'.
#
# Caller pattern:
#   local('%p');
#   %p = redrobin_alias_parse("mimikatz", @_);
#   if (redrobin_gate($1, "mimikatz", %p['raw'])) {
#       &bmimikatz($1, %p['args']);
#   }
sub redrobin_alias_parse {
    local('$cmd @argv $args');
    $cmd = $1;
    @argv = $2;
    if (size(@argv) <= 1) {
        return %(args => "", raw => $cmd);
    }
    $args = join(' ', sublist(@argv, 1));
    return %(args => $args, raw => $cmd . " " . $args);
}

alias mimikatz {
    local('%p');
    %p = redrobin_alias_parse("mimikatz", @_);
    if (redrobin_gate($1, "mimikatz", %p['raw'])) {
        &bmimikatz($1, %p['args']);
    }
}

alias dcsync {
    local('%p @parts');
    %p = redrobin_alias_parse("dcsync", @_);
    if (redrobin_gate($1, "dcsync", %p['raw'])) {
        @parts = split(' ', %p['args']);
        if (size(@parts) >= 2) {
            &bdcsync($1, @parts[0], @parts[1]);
        } else if (size(@parts) >= 1 && @parts[0] ne "") {
            &bdcsync($1, @parts[0]);
        }
        # else: empty args, don't dispatch — operator typed bare 'dcsync'
    }
}

alias hashdump {
    if (redrobin_gate($1, "hashdump", "hashdump")) {
        &bhashdump($1);
    }
}

alias logonpasswords {
    if (redrobin_gate($1, "logonpasswords", "logonpasswords")) {
        &blogonpasswords($1);
    }
}

