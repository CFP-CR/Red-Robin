# Diagnostic — Sleep HTTP latency budget.
#
# Measures the Sleep -> daemon HTTP round-trip on localhost:7777. This still
# matters after the pre-flight gate's removal: the capture emits
# (redrobin_emit_command_input / _command_output) run SYNCHRONOUSLY on the
# operator's hook thread, so a slow daemon shows up as console lag while typing.
# The 150ms bar below is inherited from the old sync-verdict budget and is now
# just a conservative "does not feel laggy" threshold, not a protocol deadline.
#
# `rrlatency` is a standalone diagnostic command — it does NOT override any
# Cobalt Strike built-in, and this spike file is never loaded by redrobin.cna.
#
# Requires the stub daemon at adapters/cobaltstrike/spike/stub_daemon.py running.
# Start it before loading this .cna:
#   uv run python adapters/cobaltstrike/spike/stub_daemon.py
#
# To use:
#   1. CS Client → Scripts → Load → adapters/cobaltstrike/spike/test_http_latency.cna
#   2. In any Beacon console: rrlatency

import java.net.*;
import java.io.*;

sub measure_http {
    local('$url $conn $start $end $elapsed');
    $url = [new URL: "http://localhost:7777/v1/ping"];
    $start = ticks();
    $conn = [$url openConnection];
    [$conn setRequestMethod: "GET"];
    [$conn setConnectTimeout: 200];
    [$conn setReadTimeout: 200];
    [$conn getResponseCode];
    [$conn disconnect];
    $end = ticks();
    $elapsed = $end - $start;
    return $elapsed;
}

alias rrlatency {
    local('@samples $i $sample $sum $count $avg $max');
    @samples = @();
    for ($i = 0; $i < 50; $i++) {
        push(@samples, measure_http());
    }
    # Compute aggregates manually (Sleep doesn't have sum/max in core stdlib uniformly)
    $sum = 0;
    $max = 0;
    foreach $sample (@samples) {
        $sum += $sample;
        if ($sample > $max) { $max = $sample; }
    }
    $count = size(@samples);
    $avg = $sum / $count;
    blog($1, "===== Red Robin Spike: HTTP latency =====");
    blog($1, "Samples: " . $count);
    blog($1, "Avg: " . $avg . "ms");
    blog($1, "Max: " . $max . "ms");
    blog($1, "Budget: 150ms");
    if ($max < 150) {
        blog($1, "Result: PASS — synchronous capture emits will not lag the console.");
    } else {
        blog($1, "Result: FAIL — capture emits may lag operator typing; investigate the daemon.");
    }
}
