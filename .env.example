# Red Robin local configuration — copy to .env and fill in the secrets.
# Explicit shell env vars OVERRIDE these values (safe precedence).

# === REQUIRED SECRETS ===
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# === DAEMON NETWORK ===
REDROBIN_HOST=127.0.0.1
REDROBIN_PORT=7777

# === ROOT + ENGAGEMENT ===
# REDROBIN_ROOT defaults to ~/.redrobin; set explicitly if you want a different layout.
# REDROBIN_ROOT=/path/to/redrobin/state
REDROBIN_ENGAGEMENT_SLUG=op-smoke

# === TUNING (sane defaults shown) ===
REDROBIN_PROMOTER_INTERVAL_SEC=60
REDROBIN_PROMOTER_MIN_OCCURRENCES=3
REDROBIN_L5_WINDOW=25
REDROBIN_L5_INTERVAL_SEC=30

# === POLICY ===
# Set to 1 to allow daemon to start with a degraded Layer B (no LLM key).
# Default 0 fails fast at boot if ANTHROPIC_API_KEY is missing.
REDROBIN_ALLOW_DEGRADED=0
